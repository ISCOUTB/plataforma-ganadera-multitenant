# =============================================================================
# .gitignore — FarmLink
# =============================================================================

# --- Dependencias ---
node_modules/
.pub-cache/
.dart_tool/

# --- Variables de entorno (NUNCA versionar secretos) ---
.env
.env.*
!.env.example

# --- Compilados y builds ---
dist/
build/
coverage/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*

# --- macOS ---
.DS_Store
**/.DS_Store
*._.DS_Store
__MACOSX/

# --- IDEs ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

.claude/

# --- Flutter específico ---
*.g.dart
*.freezed.dart

# --- Fases y planificación ---
fases/
Fases/
prompts/
*.prompt.md
PLAN_DE_TRABAJO_LOCAL.md

# --- Builds específicos ---
Backend/dist/
frontend-react/node_modules/
frontend-react/dist/.run/

# --- Runtime artifacts (PID files, logs del start.sh) ---
.run/

# --- Notas / credenciales locales ---
pass.tx
pass.txt
secrets.txt
*.secret

# --- Backups ---
*.bak
*.orig
*.swp
*.swo

# --- Temporal — agregados después por compañera ---
Frontend/android/app/src/
AGENTS.md
.github/copilot-instructions.md
.github/skills/
*~

# --- Otras carpetas IDE/agentes ---
.claudecode/
.cursor/
.history/

# --- Windows basura ---
Thumbs.db
desktop.ini

# --- Documentos de arquitectura y guías ---
AI_MODEL_ARCHITECTURE.md
FRONTEND_ARCHITECTURE.md
IA_IMPLEMENTATION.md
RESUMEN.md
SETUP_GUIDE.md

# --- Agentes y configuración opencode ---
.agents/
opencode.json
